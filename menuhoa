  <script>
// ==============================
// 🛒 CART SYSTEM — FULL VERSION
// ==============================

// Load cart from localStorage
function getCart() {
  return JSON.parse(localStorage.getItem("cart") || "[]");
}

// Save cart back to localStorage
function saveCart(cart) {
  localStorage.setItem("cart", JSON.stringify(cart));
  updateCartBadge();
}

// Update the Cart badge count
function updateCartBadge() {
  const cart = getCart();
  const badge = document.querySelector(".badge");
  badge.textContent = cart.reduce((sum, item) => sum + item.qty, 0);
}

// Add item to cart
function addToCart(name, price, img) {
  let cart = getCart();

  const existing = cart.find(item => item.name === name);

  if (existing) {
    existing.qty += 1;
  } else {
    cart.push({
      name: name,
      price: Number(price.replace("$","")),
      img: img,
      qty: 1
    });
  }

  saveCart(cart);
  alert(name + " added to cart!");
}

// Render cart inside modal
function renderCart() {
  const cart = getCart();
  const cartBody = document.querySelector("#cartModal .modal-body");

  if (cart.length === 0) {
    cartBody.innerHTML = "<p>No items in your cart yet.</p>";
    return;
  }

  let html = `
    <table class="table">
      <tr>
        <th>Product</th><th>Qty</th><th>Price</th><th></th>
      </tr>
  `;

  let total = 0;

  cart.forEach((item, index) => {
    total += item.price * item.qty;
    html += `
      <tr>
        <td><img src="${item.img}" width="50" class="rounded me-2">${item.name}</td>
        <td>
          <button class="btn btn-sm btn-outline-secondary" onclick="updateQty(${index}, -1)">-</button>
          <span class="mx-2">${item.qty}</span>
          <button class="btn btn-sm btn-outline-secondary" onclick="updateQty(${index}, 1)">+</button>
        </td>
        <td>$${(item.price * item.qty).toFixed(2)}</td>
        <td><button class="btn btn-sm btn-danger" onclick="removeItem(${index})">X</button></td>
      </tr>
    `;
  });

  html += `
      <tr>
        <td colspan="4" class="text-end fw-bold fs-5">Total: $${total.toFixed(2)}</td>
      </tr>
    </table>
  `;

  cartBody.innerHTML = html;
}

// Update quantity
function updateQty(index, change) {
  let cart = getCart();
  cart[index].qty += change;

  if (cart[index].qty <= 0) cart.splice(index, 1);

  saveCart(cart);
  renderCart();
}

// Remove item
function removeItem(index) {
  let cart = getCart();
  cart.splice(index, 1);
  saveCart(cart);
  renderCart();
}

// EVENT: When Product Modal opens → setup Add to Cart button
const productModalEl = document.getElementById("productModal");
productModalEl.addEventListener("show.bs.modal", event => {
  const button = event.relatedTarget;
  const name = button.getAttribute("data-name");
  const price = button.getAttribute("data-price");
  const img = button.getAttribute("data-img");

  document.getElementById("modalName").textContent = name;
  document.getElementById("modalPrice").textContent = price;
  document.getElementById("modalImg").src = img;

  const addBtn = productModalEl.querySelector(".btn-success");

  addBtn.onclick = () => addToCart(name, price, img);
});

// EVENT: When Cart Modal opens → render items
const cartModal = document.getElementById("cartModal");
cartModal.addEventListener("show.bs.modal", renderCart);

// Init badge number on page load
updateCartBadge();
</script>

